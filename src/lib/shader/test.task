#version 460
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_mesh_shader : enable
#extension GL_ARB_gpu_shader_int64 : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// test glsl packing rules
layout(local_size_x = 1) in; // not using the usual 32 threads per workgroup, but only 1 as we implement object culling and LOD object selection here

// see pbrShader.h
struct GPUMemoryPushConstants {
    uint64_t collectionIndicesAddress;
    uint64_t collectionInfosAddress;
    uint64_t meshInfosAddress;
    uint64_t uniformBufferAddress;
    uint64_t storageBufferAddress;
    uint64_t vertexBufferAddress;
    uint64_t indexBufferAddress;
    uint64_t indirectBufferAddress;
    uint64_t textureBufferAddress;
};

// see Object.h for C++ side
struct GPUCollectionIndex {
    uint gpuCollectionIndex; // index into CollectionInfos (== index of first major mesh of this collection)
	uint mainMeshCount; // number of main meshes in this collection
};

struct GPUMeshInfo {
	uint64_t meshletOffset; // offset into global mesh storage buffer
	uint64_t localIndexOffset; // offset into global mesh storage buffer
	uint64_t globalIndexOffset; // offset into global mesh storage buffer
	uint64_t vertexOffset; // offset into global mesh storage buffer
    uint meshletCount; // number of meshlets for this LOD
    uint pad0;
};

layout(binding = 0) uniform UniformBufferObject {
    mat4 model;
    mat4 view;
    mat4 proj;
    vec4 baseColor;
	uint frameNum;      // new: current frame number
	uint pad0;          // pad to 16-byte multiple if desired (optional)
	uint pad1;          // pad to 16-byte multiple if desired (optional)
	uint pad2;          // pad to 16-byte multiple if desired (optional)
    GPUMemoryPushConstants gpuMem;
    vec3 camPos;
} ubo;

/* minmal set needed from 'old' model_ubo
boundingBox
meshNumber
flags
model
material.lod_category
*/

// mesh infos on GPU global buffer:
layout(buffer_reference, std430) buffer GPUCollectionIndexBuffer {
    GPUCollectionIndex index[];
};

layout(buffer_reference, std430) buffer GPUMeshInfoBuffer {
    GPUMeshInfo info[];
};

layout(push_constant) uniform PushConstants {
	uint objectNum;  // 4 bytes only!
	uint pad0;          // pad to 16-byte multiple if desired (optional)
	uint pad1;          // pad to 16-byte multiple if desired (optional)
	uint pad2;          // pad to 16-byte multiple if desired (optional)
} pushConstants;


struct TaskPayload {
    mat4 mvp;
    uint meshIndex; // LOD selection
    uint meshletIndex; // only used for discarding
    // single meshlet to draw DO NOT iterate meshletIndex, emit multiple mesh shader calls at once with EmitMeshTasksEXT(meshletsCount, 1, 1);
};

taskPayloadSharedEXT TaskPayload payload;

GPUCollectionIndexBuffer gpuIndices = GPUCollectionIndexBuffer(ubo.gpuMem.collectionIndicesAddress + 0);
GPUMeshInfoBuffer gpuInfos = GPUMeshInfoBuffer(ubo.gpuMem.meshInfosAddress + 0);

void main() {
    bool debugIndices = true;
    bool debugInfos = true;
    //uint meshIndex = 42;
    //debugPrintfEXT("test.task main: meshIndex %u\n", meshIndex);
    //uint meshletsCount = gpuInfos.info[meshIndex].meshletCount;
    //float meshletsCount = gpuInfos.info[meshIndex].f;
    //debugPrintfEXT("test.task main ubo camPos.xyz: %f %f %f\n", ubo.camPos.x, ubo.camPos.y, ubo.camPos.z);
    debugPrintfEXT("test.task ubo: frameNum %u\n", ubo.frameNum);
    debugPrintfEXT("test.task push: objectNum %u\n", pushConstants.objectNum);
    debugPrintfEXT("TEST TASK SHADER PUUUUSH: : %llx %llx\n", ubo.gpuMem.collectionIndicesAddress, ubo.gpuMem.meshInfosAddress);
    if (debugIndices) {
        debugPrintfEXT("TEST TASK SHADER PUUUUSH: : %llx %llx\n", ubo.gpuMem.collectionIndicesAddress, ubo.gpuMem.meshInfosAddress);
        for ( int i = 0; i < 5; i++) {
            uint idx = gpuIndices.index[i].gpuCollectionIndex;
            debugPrintfEXT(" %x", idx);
        }
        debugPrintfEXT("\n");
    }
    if (debugInfos) {
        debugPrintfEXT("TEST TASK SHADER PUUUUSH: : %llx %llx\n", ubo.gpuMem.collectionIndicesAddress, ubo.gpuMem.meshInfosAddress);
        uint idx = gpuIndices.index[1].gpuCollectionIndex;
        idx = 11;
        GPUMeshInfo info = gpuInfos.info[idx];
        debugPrintfEXT("[ %x ] vertexOffset %llx globalIndexOffset %llx localIndexOffset %llx meshletOffset %llx meshletCount %u\n",
            idx, info.vertexOffset, info.globalIndexOffset, info.localIndexOffset, info.meshletOffset, info.meshletCount);
        for ( int i = 0; i < 5; i++) {
            //uint f = gpuIndices.index[0].gpuMeshInfoIndex[i];
            //debugPrintfEXT(" %x", f);
        }
        debugPrintfEXT("\n");
        //debugPrintfEXT("f %f", meshletsCount);
    }
}

